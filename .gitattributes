# Normalize line endings in the repository to LF
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
LICENSE text eol=lf

# Binary content — leave untouched
*.pkl   binary
*.zip   binary
*.exe   binary
*.png   binary
*.jpg   binary

# EEPROM snapshots: keep them out of diffs
backup_*.json -diff
